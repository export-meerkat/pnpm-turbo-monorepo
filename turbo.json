{
  "$schema": "https://turbo.build",
  "tasks": {
    "sync:db-types": {
      "cache": false
    },
    "@expo-meerkat/types#build": {
      "inputs": ["src/**/*.ts", "package.json"],
      "outputs": ["dist/**"]
    },
    "//#openapi": {
      "cache": false,
      "dependsOn": ["@expo-meerkat/types#build"],
      "inputs": ["scripts/build-openapi.js", "packages/types/dist/index.js"],
      "outputs": ["openapi.json"]
    },
    "build": {
      "dependsOn": ["^build", "@expo-meerkat/types#build"],
      "outputs": [".next/**", "!.next/cache/**", ".output/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
